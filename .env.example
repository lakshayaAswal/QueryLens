# Set these values in the process environment or deployment secret manager.
# Export the settings before starting Streamlit.
QUERYLENS_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Uncomment and set custom paths when needed.
# QUERYLENS_DATA_DIR=/path/to/private/querylens-data
# QUERYLENS_SQLITE_PATH=/path/to/analytics.sqlite

# Optional server-configured database. Inject the password via a secret store.
# QUERYLENS_DB_DIALECT=postgresql
# QUERYLENS_DB_HOST=analytics-db.example.com
# QUERYLENS_DB_PORT=5432
# QUERYLENS_DB_NAME=analytics
# QUERYLENS_DB_SCHEMA=public
# QUERYLENS_DB_USER=analytics_reader
# QUERYLENS_DB_PASSWORD=
# QUERYLENS_DB_SSL_MODE=verify-full
# PGSSLROOTCERT=/path/to/postgresql-ca.pem
# AI_SQL_MYSQL_SSL_CA=/path/to/mysql-ca.pem

QUERYLENS_TIMEOUT_SECONDS=10
QUERYLENS_MAX_ROWS=1000

# Configure Streamlit OIDC before enabling sign-in.
QUERYLENS_REQUIRE_LOGIN=0
# QUERYLENS_DB_HOSTS=analytics-db.example.com,warehouse.example.com
