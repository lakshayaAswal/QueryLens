{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "hosted.py": {
      "maxDuration": 150,
      "excludeFiles": "{tests/**,README.md,style.css,start-windows.cmd,app.py,.streamlit/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
